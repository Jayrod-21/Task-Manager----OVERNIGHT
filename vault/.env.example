# PostgreSQL Database Configuration
# Database name for Vault
POSTGRES_DB=vault

# PostgreSQL username
POSTGRES_USER=vault_user

# PostgreSQL password — change this to a secure value
POSTGRES_PASSWORD=vault_secret_change_me

# Database host — matches the Docker Compose service name
DATABASE_HOST=db

# Database port — internal PostgreSQL port
DATABASE_PORT=5432

# Full database URL (constructed from above values)
DATABASE_URL=postgresql://vault_user:vault_secret_change_me@db:5432/vault

# Anthropic API Key — required for AI description helper
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Backend host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend API URL — used by the React app to call the backend
VITE_API_URL=http://localhost:8000
